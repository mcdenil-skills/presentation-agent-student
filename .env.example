# === Необязательные ключи presentation-agent ===
# Скопируй этот файл в .env и впиши свои значения.
# Сам .env в git НЕ попадает - это твои личные ключи.

# Pexels - бесплатный поиск фото для слайдов.
# Получить ключ: https://www.pexels.com/api/
PEXELS_API_KEY=

# OpenAI - генерация картинок (gpt-image, платно).
# Получить ключ: https://platform.openai.com/api-keys
# Можно оставить пустым, если генерация картинок не нужна.
OPENAI_API_KEY=
